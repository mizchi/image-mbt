///|
fn tiff_join(parts : Array[Bytes]) -> Bytes {
  let buf = Buffer()
  for p in parts {
    buf.write_bytes(p)
  }
  buf.to_bytes()
}

///|
fn tiff_normalize(px : Bytes) -> Bytes {
  let b = px.to_fixedarray()
  for i in 0..<(b.length() / 4) {
    if b[i * 4 + 3] == b'\x00' {
      b[i * 4] = b'\x00'
      b[i * 4 + 1] = b'\x00'
      b[i * 4 + 2] = b'\x00'
    }
  }
  Bytes::from_array(b)
}


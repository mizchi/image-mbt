    e => Err(e)
  }
  assert_true(big is Err(@image.UnsupportedFeature(_)))
  let bad = Ok(@image.decode_tiff(b"II\x2A\x01\x08\x00\x00\x00")) catch {
    e => Err(e)
  }
  assert_true(bad is Err(@image.InvalidSignature(_)))
  // IFD offset past the end of the file.
  let trunc = Ok(@image.decode_tiff(b"II\x2A\x00\xFF\x00\x00\x00")) catch {
    e => Err(e)
  }
  assert_true(trunc is Err(@image.CorruptData(_)))
}

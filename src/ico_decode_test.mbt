///|
test "ico: encode_ico roundtrip" {
  let data = FixedArray::make(7 * 5 * 4, b'\x00')
  for i in 0..<data.length() {
    data[i] = (i * 37).to_byte()
  }
  let img : @image.ImageData = {
    width: 7,
    height: 5,
    data: Bytes::from_array(data),
  }
  let decoded = @image.decode_ico(@image.encode_ico(img))
  assert_eq(decoded, img)
}

///|
test "ico: invalid input" {
  let not_ico = Ok(@image.decode_ico(b"\x00\x00\x03\x00\x01\x00")) catch {
    e => Err(e)
  }
  assert_true(not_ico is Err(@image.InvalidSignature(_)))
  let empty = Ok(@image.decode_ico(b"\x00\x00\x01\x00\x00\x00")) catch {
    e => Err(e)
  }
  assert_true(empty is Err(@image.CorruptData(_)))
  let truncated = Ok(
    @image.decode_ico(
      b"\x00\x00\x01\x00\x01\x00\x10\x10\x00\x00\x01\x00\x20\x00\xFF\x00\x00\x00\x16\x00\x00\x00",
    ),
  ) catch {
    e => Err(e)
  }
  assert_true(truncated is Err(@image.CorruptData(_)))
}

///|
test "decode_image: detects PNG, JPEG, BMP and ICO" {
  let data = FixedArray::make(8 * 8 * 4, b'\xFF')
  let img : @image.ImageData = {
    width: 8,
    height: 8,
    data: Bytes::from_array(data),
  }
  assert_eq(@image.decode_image(@image.encode_png(img)), img)
  assert_eq(@image.decode_image(@image.encode_bmp(img)), img)
  assert_eq(@image.decode_image(@image.encode_ico(img)), img)
  let jpg = @image.encode_jpeg(img)
  assert_eq(@image.decode_image(jpg), @image.decode_jpeg(jpg))
  let unknown = Ok(@image.decode_image(b"GIF89a")) catch { e => Err(e) }
  assert_true(unknown is Err(@image.InvalidSignature(_)))
}

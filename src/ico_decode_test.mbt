  let expected = b"\x6E\x37\xB6\xFF\x3D\x3C\x50\x00\x7E\xA9\x86\xFF\x74\xE0\xB5\x00\x3D\x57\x93\xFF\x0D\x2A\x23\x00\x5D\xAC\x35\x00\xB1\xEC\xE9\xFF\xBC\x05\xCC\x00\x72\xE8\xAC\xFF\x94\xE5\x93\xFF\xCA\x3E\x5E\x00\xF7\x40\xD5\x00\xB4\x5D\x54\x00\xD6\x37\x00\x00\xED\x7A\xAE\xFF\xF8\xF9\x3F\xFF\xED\xFE\x1A\xFF\x40\x9E\xEB\x00\x51\x5E\x42\x00\x6D\x47\x54\x00\x25\x62\xB6\xFF\x2D\x6D\xD7\x00\xB4\xE2\x95\xFF\xEF\x17\x25\x00\xD0\xB3\x61\x00\xA6\xEA\x7E\xFF\xB9\x74\x3F\x00\x39\x44\x78\xFF\xCF\xCE\x6A\xFF\x4F\xF6\x8C\x00\x6E\x83\x42\xFF\x11\x77\xC4\xFF\x63\x72\x9D\xFF\x3F\x01\xF2\x00\x7D\x32\x2C\xFF\x57\xED\xC5\x00\x7F\xBE\x2E\xFF\x3B\x8A\x86\xFF\x0E\x09\xC5\xFF\xE7\xE0\xE7\x00\x18\xF1\xB9\x00\xA8\x2E\x7D\x00\x94\x52\x5C\x00\xB2\xA3\x60\x00\x35\xD1\x17\x00\x08\x33\x09\xFF\xD6\xB9\x19\xFF\x81\x9C\x31\xFF\x97\x59\x56\xFF\x84\xC9\x79\xFF\x70\x08\x35\xFF\x20\x54\x84\xFF\xE2\x4C\x9F\xFF\x2C\xE0\x1B\x00\x92\x06\xB1\x00\x19\xA5\xC0\xFF\xDF\x01\xCB\xFF\xE4\x5B\xB2\x00\x0F\x61\x14\xFF\x04\x35\x75\x00\x45\xCB\xC2\x00\x59\xE1\x9B\xFF"
  let img = @image.decode_ico(ico)
  assert_eq(img.width, 9)
  assert_eq(img.height, 7)
  assert_eq(img.data, expected)
  assert_eq(@image.decode_ico_all(ico).length(), 1)
  assert_eq(@image.decode_image(ico).data, expected)
}


test "ico: 32-bit DIB with zero alpha uses AND mask" {
  let ico = b"\x00\x00\x01\x00\x01\x00\x06\x05\x00\x00\x01\x00\x20\x00\xB4\x00\x00\x00\x16\x00\x00\x00\x28\x00\x00\x00\x06\x00\x00\x00\x0A\x00\x00\x00\x01\x00\x20\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xD1\xB4\xCE\x00\x6E\x72\x3D\x00\x8E\x97\x78\x00\x5C\x53\x47\x00\xAE\xAD\xDC\x00\x14\xEB\x3C\x00\xCE\xB1\x49\x00\x81\xC0\x36\x00\xE6\xE9\xE6\x00\x6D\x3A\xAB\x00\xA3\x1A\x13\x00\x13\x47\x1E\x00\x60\x20\xEB\x00\xF9\x73\x1B\x00\x0F\x40\x76\x00\x8F\xFA\xA7\x00\x31\x5C\xE6\x00\x7E\xB5\x0C\x00\x4D\xCE\x1E\x00\xE2\x6B\xDA\x00\xDD\x8D\xD6\x00\x31\x28\x9F\x00\x3B\x44\xE0\x00\x64\x5B\x77\x00\xF6\xDD\x1E\x00\x18\xFE\x74\x00\xB0\xC8\x66\x00\xCF\x8C\xF3\x00\xE9\x92\x87\x00\xB1\xD4\xA2\x00\x54\x00\x00\x00\xDC\x00\x00\x00\xF8\x00\x00\x00\x44\x00\x00\x00\x6C\x00\x00\x00"
  let expected = b"\x1E\xDD\xF6\xFF\x74\xFE\x18\x00\x66\xC8\xB0\x00\xF3\x8C\xCF\xFF\x87\x92\xE9\x00\xA2\xD4\xB1\x00\x1E\xCE\x4D\xFF\xDA\x6B\xE2\x00\xD6\x8D\xDD\xFF\x9F\x28\x31\xFF\xE0\x44\x3B\xFF\x77\x5B\x64\x00\xEB\x20\x60\x00\x1B\x73\xF9\x00\x76\x40\x0F\x00\xA7\xFA\x8F\x00\xE6\x5C\x31\x00\x0C\xB5\x7E\xFF\x49\xB1\xCE\x00\x36\xC0\x81\x00\xE6\xE9\xE6\xFF\xAB\x3A\x6D\x00\x13\x1A\xA3\x00\x1E\x47\x13\x00\xCE\xB4\xD1\xFF\x3D\x72\x6E\x00\x78\x97\x8E\xFF\x47\x53\x5C\x00\xDC\xAD\xAE\xFF\x3C\xEB\x14\x00"
  let img = @image.decode_ico(ico)
  assert_eq(img.width, 6)
  assert_eq(img.height, 5)
  assert_eq(img.data, expected)
  assert_eq(@image.decode_ico_all(ico).length(), 1)
  assert_eq(@image.decode_image(ico).data, expected)
}


  let ico = b"\x00\x00\x01\x00\x01\x00\x05\x06\x00\x00\x01\x00\x04\x00\x98\x00\x00\x00\x16\x00\x00\x00\x28\x00\x00\x00\x05\x00\x00\x00\x0C\x00\x00\x00\x01\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x16\xE2\x00\x00\x74\x3B\xAC\x00\xAB\x89\x1C\x00\xB8\xFB\x88\x00\x69\x54\x8D\x00\x74\x8E\x8F\x00\x26\x42\x3B\x00\x19\xEA\x0C\x00\x62\xB1\x63\x00\x64\x18\x06\x00\x46\x47\x1B\x00\xD3\xDD\xA3\x00\x3E\xCA\x5D\x00\x6D\x1B\xE6\x00\x66\x09\x20\x00\xE5\x5E\xB4\x00\x7F\x4B\x20\x00\xA5\xC9\xB0\x00\x9E\x07\x00\x00\x0F\xFD\x40\x00\xEA\x2D\x30\x00\x24\x83\x90\x00\xB8\x00\x00\x00\xC0\x00\x00\x00\x38\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\x18\x00\x00\x00"
  let expected = b"\x1C\x89\xAB\xFF\x8D\x54\x69\xFF\x63\xB1\x62\xFF\x88\xFB\xB8\x00\x06\x18\x64\x00\x20\x09\x66\xFF\x1B\x47\x46\xFF\x1C\x89\xAB\xFF\xE6\x1B\x6D\xFF\x88\xFB\xB8\xFF\x00\xE2\x16\xFF\xB4\x5E\xE5\xFF\xB4\x5E\xE5\xFF\xE6\x1B\x6D\x00\x8D\x54\x69\x00\x06\x18\x64\xFF\x20\x09\x66\xFF\x00\xE2\x16\x00\x0C\xEA\x19\x00\x00\xE2\x16\x00\x1B\x47\x46\x00\x8F\x8E\x74\x00\x5D\xCA\x3E\xFF\x06\x18\x64\xFF\xA3\xDD\xD3\xFF\x0C\xEA\x19\x00\xB4\x5E\xE5\xFF\x8D\x54\x69\x00\xA3\xDD\xD3\x00\x1C\x89\xAB\x00"
  let img = @image.decode_ico(ico)

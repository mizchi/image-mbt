    b"\x3C\x87\xCC\xE6\xDF\xAA\xD5\x14\x4B\xB3\xBF\x99\x5B\x09\x00\x00\x41\x4E\x4D\x46\xBA\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1D\x00\x00\x13\x00\x00\x28\x00\x00\x02\x56\x50\x38\x4C\xA1\x00\x00\x00",

  let anim = @image.decode_webp_frames(webp)
  assert_eq(anim.width, 30)
  assert_eq(anim.height, 20)
  assert_eq(anim.plays, 3)
  assert_eq(anim.frames.length(), 3)
  assert_eq(anim.frames[0].delay_ms, 100)
  assert_eq(webp_crc(anim.frames[0].image.data), 0x67C8A784)
  assert_eq(anim.frames[1].delay_ms, 250)
  assert_eq(webp_crc(anim.frames[1].image.data), 0x5E16C2F0)
  assert_eq(anim.frames[2].delay_ms, 40)
  assert_eq(webp_crc(anim.frames[2].image.data), 0x1C1A4EE5)
  assert_eq(webp_crc(@image.decode_webp(webp).data), 0x67C8A784)
}


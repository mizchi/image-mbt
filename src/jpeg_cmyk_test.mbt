// Generated by gen_cmyk.py: CMYK / YCCK / RGB JPEGs written by Pillow
// (libjpeg-turbo), some with patched or removed APP0 / APP14 markers.
// Expected pixels are Pillow's decode converted to RGB (CRC-32 of RGBA).

///|
fn jpeg_cmyk_join(parts : Array[Bytes]) -> Bytes {
  let buf = Buffer()
  for p in parts {
    buf.write_bytes(p)
  }
  buf.to_bytes()
}

///|
fn jpeg_cmyk_crc(px : Bytes) -> Int32 {
  @zlib.crc32_fixed(px.to_fixedarray()).reinterpret_as_int()
}


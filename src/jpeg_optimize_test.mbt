// Generated by gen_jpeg_opt.py: encode_jpeg(optimize=true) must produce the
// same Huffman tables and entropy-coded data as Pillow (libjpeg-turbo) with
// optimize=True. Images come from a formula with LCG noise (same as the
// generator); CRC-32 of the DHT tables (sorted by class / id) and the scan.

///|
fn jpeg_opt_image(
  w : Int32,
  h : Int32,
  seed : Int32,
  noise : Int32,
) -> @image.ImageData {
  let px = FixedArray::make(w * h * 4, b'\xFF')
  let mut s = seed
  for y in 0..<h {
    for x in 0..<w {
      s = (s * 1103515245 + 12345) & 0x7FFFFFFF
      let n = if noise > 0 { (s >> 16) % (noise + 1) } else { 0 }
      let o = (y * w + x) * 4
      px[o] = (x * 3 + y * 5 + n).to_byte()
      px[o + 1] = (((x * y) >> 3) + n).to_byte()
      px[o + 2] = ((x * 7) ^ (y * 2)).to_byte()
    }
  }
  { width: w, height: h, data: Bytes::from_array(px), }
}

///|
/// (DHT tables sorted by class / id, entropy-coded data) of a baseline JPEG.
fn jpeg_opt_parts(d : Bytes) -> (Bytes, Bytes) {
  let tables : Array[Bytes] = []
  let mut p = 2
  while p + 4 <= d.length() {
    let m = d[p + 1]
    let n = (d[p + 2].to_int() << 8) | d[p + 3].to_int()
    if m == b'\xC4' {
      let mut q = p + 4
      while q < p + 2 + n {
        let mut cnt = 0
        for i in 1..<=16 {
          cnt += d[q + i].to_int()
        }
        tables.push(d[q:q + 17 + cnt].to_owned())
        q += 17 + cnt
      }
    }
    if m == b'\xDA' {
      tables.sort_by(fn(a, b) { a[0].to_int() - b[0].to_int() })
      let buf = Buffer()
      for t in tables {
        buf.write_bytes(t)
      }
      return (buf.to_bytes(), d[p + 2 + n:d.length() - 2].to_owned())
    }
    p += 2 + n
  }
  (b"", b"")
}

///|
fn jpeg_opt_crc(b : Bytes) -> Int32 {
  @zlib.crc32_fixed(b.to_fixedarray()).reinterpret_as_int()
}

///|
test "jpeg optimize matches libjpeg: 37x21 q85 Yuv420 noise 40" {
  let img = jpeg_opt_image(37, 21, 1, 40)
  let jpg = @image.encode_jpeg(
    img,
    quality=85,
    subsampling=@image.Yuv420,
    optimize=true,
  )
  let (dht, scan) = jpeg_opt_parts(jpg)
  assert_eq(jpeg_opt_crc(dht), 0xDF6132E0)
  assert_eq(jpeg_opt_crc(scan), 0x240FD2CA)
  assert_eq(scan.length(), 361)
}

///|
test "jpeg optimize matches libjpeg: 37x21 q85 Yuv422 noise 0" {
  let img = jpeg_opt_image(37, 21, 2, 0)
  let jpg = @image.encode_jpeg(
    img,
    quality=85,
    subsampling=@image.Yuv422,
    optimize=true,
  )
  let (dht, scan) = jpeg_opt_parts(jpg)
  assert_eq(jpeg_opt_crc(dht), 0x1F427657)
  assert_eq(jpeg_opt_crc(scan), 0xF1DCCE83)
  assert_eq(scan.length(), 171)
}

///|
test "jpeg optimize matches libjpeg: 37x29 q85 Yuv444 noise 10" {
  let img = jpeg_opt_image(37, 29, 3, 10)
  let jpg = @image.encode_jpeg(
    img,
    quality=85,
    subsampling=@image.Yuv444,
    optimize=true,
  )
  let (dht, scan) = jpeg_opt_parts(jpg)
  assert_eq(jpeg_opt_crc(dht), 0xDE956B21)
  assert_eq(jpeg_opt_crc(scan), 0xE5997B4F)
  assert_eq(scan.length(), 389)
}


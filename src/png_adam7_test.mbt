  let rows : Array[Int32] = []
  let buf = FixedArray::make(expected.length(), b'\x00')
  let ihdr = @image.decode_png_stream(interlaced, on_row=fn(y, row) {
    rows.push(y)
    buf.blit_from_bytes(y * 52, row, 0, 52)
  })
  assert_eq(ihdr.interlace, 1)
  assert_eq(rows, Array::makei(11, fn(i) { i }))
  assert_eq(Bytes::from_array(buf), expected)

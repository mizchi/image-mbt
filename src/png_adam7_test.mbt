  let plain = b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x09\x00\x00\x00\x01\x08\x06\x00\x00\x00\x0C\xC2\x84\x7D\x00\x00\x00\x2E\x49\x44\x41\x54\x78\x9C\x63\xA8\xFA\x66\x35\x6F\x7B\x4F\x77\x62\x5F\x55\x62\x7D\x8A\x88\x3C\x4B\x57\xCB\x4D\x5E\x61\x93\xC2\x3E\x55\x9D\xA0\x8A\xFD\xDF\xBF\x6E\xCD\x5E\xBB\xFE\x2F\x00\x30\x69\x11\x74\xB0\x17\xAF\xAC\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82"
  let expected = b"\x7A\xF6\x3A\x9E\xB7\x8C\x8B\x61\x8E\x7A\x61\x7F\x64\x14\x1F\x04\x8A\x84\xD9\x0D\x13\x34\x71\x8E\x25\x2C\x52\x78\xBF\xF7\xF5\xB5\x6B\xAD\xAF\xFD"

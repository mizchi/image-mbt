/// Entropy-coded data of a baseline JPEG (between the SOS header and EOI).
fn jpeg_enc_scan_data(data : Bytes) -> Bytes {
  for i in 0..<(data.length() - 1) {
    if data[i] == b'\xFF' && data[i + 1] == b'\xDA' {
      let n = (data[i + 2].to_int() << 8) | data[i + 3].to_int()
      return data[i + 2 + n:data.length() - 2].to_owned()
    }
  }
  b""
}


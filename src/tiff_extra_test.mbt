  assert_eq(tiff_x_crc(pages[0].data), 0xDC0D10A4)
  assert_eq((pages[1].width, pages[1].height), (37, 23))
  assert_eq(tiff_x_crc(pages[1].data), 0x7AB970E2)
  assert_eq((pages[2].width, pages[2].height), (19, 9))
  assert_eq(tiff_x_crc(pages[2].data), 0x789D4491)
  assert_eq(@image.decode_tiff(tif).data, pages[0].data)
}


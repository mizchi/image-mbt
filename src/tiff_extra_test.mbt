// Generated by gen_tiff_extra.py: JPEG-compressed and multi-page TIFFs
// written by Pillow (libtiff / libjpeg-turbo). Expected pixels are Pillow's
// RGBA decode (CRC-32).

///|
fn tiff_x_join(parts : Array[Bytes]) -> Bytes {
  let buf = Buffer()
  for p in parts {
    buf.write_bytes(p)
  }
  buf.to_bytes()
}

///|
fn tiff_x_crc(px : Bytes) -> Int32 {
  @zlib.crc32_fixed(px.to_fixedarray()).reinterpret_as_int()
}


  let img = @image.decode_jpeg(jpg)
  let mut max_diff = 0
  let mut sum = 0
  for i in 0..<expected.length() {
    let d = (img.data[i].to_int() - expected[i].to_int()).abs()
    sum += d
    if d > max_diff {
      max_diff = d
    }
  }
  assert_true(max_diff <= 6)
  assert_true(sum * 100 <= expected.length() * 150)
}


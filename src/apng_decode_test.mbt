///|
/// Zero the RGB of fully transparent pixels (Pillow's frames are compared
/// after the same normalization).
fn apng_normalize(px : Bytes) -> Bytes {
  let b = px.to_fixedarray()
  for i in 0..<(b.length() / 4) {
    if b[i * 4 + 3] == b'\x00' {
      b[i * 4] = b'\x00'
      b[i * 4 + 1] = b'\x00'
      b[i * 4 + 2] = b'\x00'
    }
  }
  Bytes::from_array(b)
}

// APNG fixtures written by Pillow; expected frames are Pillow's composited
// RGBA frames (fully transparent pixels normalized to 0, 0, 0, 0).


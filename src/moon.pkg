import {
  "mizchi/zlib",
  "moonbitlang/core/bench",
  "moonbitlang/core/debug",
  "moonbitlang/core/math",
}

options(
  targets: {
    "avif_encode_js.mbt": [ "js" ],
    "avif_encode_non_js.mbt": [ "not", "js" ],
    "avif_encode_test.mbt": [ "js" ],
    "jpeg_dct_scalar.mbt": [ "not", "wasm" ],
    "jpeg_dct_simd.mbt": [ "wasm" ],
    "png_color_scalar.mbt": [ "not", "wasm" ],
    "png_color_simd.mbt": [ "wasm" ],
    "png_filter_scalar.mbt": [ "not", "wasm" ],
    "png_filter_simd.mbt": [ "wasm" ],
    "resize_scalar.mbt": [ "not", "wasm" ],
    "resize_simd.mbt": [ "wasm" ],
  },
)

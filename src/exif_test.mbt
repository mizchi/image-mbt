///|
test "exif: malformed or out-of-range metadata is ignored" {
  let img : @image.ImageData = {
    width: 2,
    height: 1,
    data: b"\x01\x02\x03\xFF\x04\x05\x06\xFF",
  }
  // Out-of-range orientations leave the image unchanged.
  assert_eq(@image.apply_orientation(img, 0), img)
  assert_eq(@image.apply_orientation(img, 9), img)
  // 6 = rotate 90 clockwise: 2x1 -> 1x2.
  let r = @image.apply_orientation(img, 6)
  assert_eq(r.width, 1)
  assert_eq(r.height, 2)
  assert_eq(r.data, b"\x01\x02\x03\xFF\x04\x05\x06\xFF")
  // JPEG with a truncated APP1 Exif segment.
  let jpg = b"\xFF\xD8\xFF\xE1\x00\x10Exif\x00\x00II\x2A\x00\xFF\xFF\xFF\x7F\xFF\xD9"
  assert_eq(@image.read_exif_orientation(jpg), None)
  assert_eq(@image.read_exif_orientation(b"not an image"), None)
}

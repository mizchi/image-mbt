///|
test "exif: PNG without orientation" {
  let file = b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x07\x00\x00\x00\x05\x08\x02\x00\x00\x00\x06\xF8\x61\x8F\x00\x00\x00\x24\x49\x44\x41\x54\x78\x9C\x63\x64\x60\x60\x50\xC1\x40\x2C\x0C\x36\x0C\x0C\x0C\xBC\x68\x08\x2E\x2A\x85\x8C\x90\x45\xD5\xE1\x08\x4D\xD4\x04\x82\x00\xD9\x13\x04\x64\x6C\x13\x5F\x92\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82"
  assert_eq(@image.read_exif_orientation(file), None)
  assert_eq(@image.decode_image_upright(file), @image.decode_image(file))
}

